{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mission Directives Project Installation Receipt",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "created_by",
    "project_root",
    "suite_destination",
    "suite_version",
    "tracking_mode",
    "output_root",
    "output_directories",
    "guidance",
    "installed_at"
  ],
  "properties": {
    "schema_version": { "const": "2.0" },
    "status": { "const": "installed" },
    "created_by": { "const": "mission-directives" },
    "project_root": { "type": "string", "minLength": 1 },
    "suite_destination": { "const": ".mission-directives/runtime" },
    "suite_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "tracking_mode": {
      "enum": ["ignored", "outputs", "all"]
    },
    "output_root": { "const": ".mission-directives" },
    "output_directories": {
      "type": "array",
      "prefixItems": [
        { "const": "results" },
        { "const": "reports" },
        { "const": "artifacts" },
        { "const": "plans" },
        { "const": "outputs" },
        { "const": "docs" },
        { "const": "logs" }
      ],
      "items": false
    },
    "guidance": { "type": "object" },
    "installed_at": { "type": "string", "format": "date-time" },
    "receipt_path": { "type": "string" }
  },
  "additionalProperties": false
}
