{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://generic-prompts.invalid/v3.1/CP-021.schema.json",
  "title": "CLI UX review result",
  "description": "Strict machine-readable result for the prompt. It constrains the work product; it is not a certification of professional correctness.",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "3.1.0",
      "minLength": 1
    },
    "prompt_id": {
      "type": "string",
      "const": "CP-021",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "minLength": 1
    },
    "epistemic_status": {
      "type": "string",
      "enum": [
        "FACT",
        "SUPPORTED_INFERENCE",
        "ASSUMPTION",
        "RECOMMENDATION",
        "MIXED",
        "UNKNOWN"
      ],
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 10
    },
    "result": {
      "type": "object",
      "properties": {
        "commands": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "command": {
                "type": "string",
                "minLength": 1
              },
              "aliases": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "purpose": {
                "type": "string",
                "minLength": 1
              },
              "deprecated": {
                "type": "boolean"
              },
              "documentation_status": {
                "type": "string",
                "enum": [
                  "current",
                  "stale",
                  "missing"
                ],
                "minLength": 1
              }
            },
            "required": [
              "command",
              "aliases",
              "purpose",
              "deprecated",
              "documentation_status"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "journeys": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "journey": {
                "type": "string",
                "minLength": 1
              },
              "steps": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              },
              "expected_result": {
                "type": "string",
                "minLength": 1
              },
              "observed_result": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "type": "string",
                "enum": [
                  "pass",
                  "fail",
                  "partial",
                  "not_tested"
                ],
                "minLength": 1
              }
            },
            "required": [
              "journey",
              "steps",
              "expected_result",
              "observed_result",
              "status"
            ],
            "additionalProperties": false
          }
        },
        "exit_code_matrix": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "scenario": {
                "type": "string",
                "minLength": 1
              },
              "expected_exit_code": {
                "type": "integer"
              },
              "observed_exit_code": {
                "type": "integer"
              },
              "stdout_contract": {
                "type": "string",
                "minLength": 1
              },
              "stderr_contract": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "type": "string",
                "enum": [
                  "pass",
                  "fail",
                  "not_tested"
                ],
                "minLength": 1
              }
            },
            "required": [
              "scenario",
              "expected_exit_code",
              "observed_exit_code",
              "stdout_contract",
              "stderr_contract",
              "status"
            ],
            "additionalProperties": false
          }
        },
        "dry_run_checks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "command": {
                "type": "string",
                "minLength": 1
              },
              "mutation_expected": {
                "type": "boolean"
              },
              "mutation_observed": {
                "type": "boolean"
              },
              "preview_matches_plan": {
                "type": "boolean"
              },
              "evidence_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "command",
              "mutation_expected",
              "mutation_observed",
              "preview_matches_plan",
              "evidence_ids"
            ],
            "additionalProperties": false
          }
        },
        "wrapper_parity": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "operation": {
                "type": "string",
                "minLength": 1
              },
              "wrappers": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 2
              },
              "difference": {
                "type": "string",
                "minLength": 1
              },
              "intentional": {
                "type": "boolean"
              },
              "action": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "operation",
              "wrappers",
              "difference",
              "intentional",
              "action"
            ],
            "additionalProperties": false
          }
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "finding_id": {
                "type": "string",
                "minLength": 1
              },
              "category": {
                "type": "string",
                "minLength": 1
              },
              "condition": {
                "type": "string",
                "minLength": 1
              },
              "criterion": {
                "type": "string",
                "minLength": 1
              },
              "impact": {
                "type": "string",
                "minLength": 1
              },
              "severity": {
                "type": "string",
                "enum": [
                  "critical",
                  "high",
                  "medium",
                  "low",
                  "informational"
                ],
                "minLength": 1
              },
              "evidence_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              },
              "recommendation": {
                "type": "string",
                "minLength": 1
              },
              "retest": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "finding_id",
              "category",
              "condition",
              "criterion",
              "impact",
              "severity",
              "evidence_ids",
              "recommendation",
              "retest"
            ],
            "additionalProperties": false
          }
        },
        "canonical_cli_contract": {
          "type": "object",
          "properties": {
            "naming_rules": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "output_rules": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "exit_code_rules": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "dry_run_rules": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "naming_rules",
            "output_rules",
            "exit_code_rules",
            "dry_run_rules"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "commands",
        "journeys",
        "exit_code_matrix",
        "dry_run_checks",
        "wrapper_parity",
        "findings",
        "canonical_cli_contract"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "evidence_id": {
            "type": "string",
            "description": "Stable evidence identifier.",
            "minLength": 1
          },
          "source_type": {
            "type": "string",
            "enum": [
              "file",
              "line_range",
              "command_output",
              "document",
              "dataset",
              "interview",
              "observation",
              "external_source",
              "other"
            ],
            "minLength": 1
          },
          "source": {
            "type": "string",
            "description": "Path, URL, record identifier, or source name.",
            "minLength": 1
          },
          "location": {
            "type": "string",
            "description": "Line range, section, timestamp, query, or other locator.",
            "minLength": 1
          },
          "supports": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "notes": {
            "type": "string",
            "description": "Limitations or context.",
            "minLength": 1
          }
        },
        "required": [
          "evidence_id",
          "source_type",
          "source",
          "location",
          "supports",
          "confidence",
          "notes"
        ],
        "additionalProperties": false
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "action_id": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "due_or_trigger": {
            "type": "string",
            "minLength": 1
          },
          "priority": {
            "type": "string",
            "enum": [
              "critical",
              "high",
              "medium",
              "low",
              "backlog"
            ],
            "minLength": 1
          },
          "validation": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "proposed",
              "approved",
              "in_progress",
              "blocked",
              "complete",
              "rejected"
            ],
            "minLength": 1
          }
        },
        "required": [
          "action_id",
          "action",
          "owner",
          "due_or_trigger",
          "priority",
          "validation",
          "status"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "prompt_id",
    "run_id",
    "generated_at",
    "epistemic_status",
    "summary",
    "result",
    "evidence",
    "assumptions",
    "unknowns",
    "actions"
  ],
  "additionalProperties": false
}
