{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://generic-prompts.invalid/v3.1/CP-180.schema.json",
  "title": "Executive assistant operations result",
  "description": "Strict machine-readable result for the prompt. It constrains the work product; it is not a certification of professional correctness.",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "3.1.0",
      "minLength": 1
    },
    "prompt_id": {
      "type": "string",
      "const": "CP-180",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "minLength": 1
    },
    "epistemic_status": {
      "type": "string",
      "enum": [
        "FACT",
        "SUPPORTED_INFERENCE",
        "ASSUMPTION",
        "RECOMMENDATION",
        "MIXED",
        "UNKNOWN"
      ],
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 10
    },
    "result": {
      "type": "object",
      "properties": {
        "priority_view": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "priority": {
                "type": "string",
                "minLength": 1
              },
              "outcome": {
                "type": "string",
                "minLength": 1
              },
              "next_action": {
                "type": "string",
                "minLength": 1
              },
              "owner": {
                "type": "string",
                "minLength": 1
              },
              "due": {
                "type": "string",
                "minLength": 1
              },
              "source_link": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "type": "string",
                "enum": [
                  "active",
                  "waiting",
                  "blocked",
                  "complete"
                ],
                "minLength": 1
              }
            },
            "required": [
              "priority",
              "outcome",
              "next_action",
              "owner",
              "due",
              "source_link",
              "status"
            ],
            "additionalProperties": false
          }
        },
        "calendar_actions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "event": {
                "type": "string",
                "minLength": 1
              },
              "objective": {
                "type": "string",
                "minLength": 1
              },
              "participants": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "preparation": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "travel_or_buffer": {
                "type": "string",
                "minLength": 1
              },
              "authority_status": {
                "type": "string",
                "enum": [
                  "within_authority",
                  "approval_required",
                  "approved"
                ],
                "minLength": 1
              },
              "receipt": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "event",
              "objective",
              "participants",
              "preparation",
              "travel_or_buffer",
              "authority_status",
              "receipt"
            ],
            "additionalProperties": false
          }
        },
        "inbox_queue": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "item": {
                "type": "string",
                "minLength": 1
              },
              "classification": {
                "type": "string",
                "enum": [
                  "urgent",
                  "decision",
                  "delegate",
                  "respond",
                  "schedule",
                  "reference",
                  "archive"
                ],
                "minLength": 1
              },
              "owner": {
                "type": "string",
                "minLength": 1
              },
              "next_action": {
                "type": "string",
                "minLength": 1
              },
              "deadline": {
                "type": "string",
                "minLength": 1
              },
              "confidentiality": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "item",
              "classification",
              "owner",
              "next_action",
              "deadline",
              "confidentiality"
            ],
            "additionalProperties": false
          }
        },
        "briefings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "meeting_or_trip": {
                "type": "string",
                "minLength": 1
              },
              "purpose": {
                "type": "string",
                "minLength": 1
              },
              "context": {
                "type": "string",
                "minLength": 1
              },
              "open_decisions": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "logistics": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "sensitivities": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "meeting_or_trip",
              "purpose",
              "context",
              "open_decisions",
              "logistics",
              "sensitivities"
            ],
            "additionalProperties": false
          }
        },
        "delegated_and_waiting": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "commitment": {
                "type": "string",
                "minLength": 1
              },
              "delegate": {
                "type": "string",
                "minLength": 1
              },
              "expected_result": {
                "type": "string",
                "minLength": 1
              },
              "follow_up": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "type": "string",
                "enum": [
                  "delegated",
                  "waiting",
                  "blocked",
                  "complete"
                ],
                "minLength": 1
              }
            },
            "required": [
              "commitment",
              "delegate",
              "expected_result",
              "follow_up",
              "status"
            ],
            "additionalProperties": false
          }
        },
        "external_actions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "action": {
                "type": "string",
                "minLength": 1
              },
              "target": {
                "type": "string",
                "minLength": 1
              },
              "authority": {
                "type": "string",
                "minLength": 1
              },
              "approved_by": {
                "type": "string",
                "minLength": 1
              },
              "executed_at": {
                "type": "string",
                "minLength": 1
              },
              "receipt": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "action",
              "target",
              "authority",
              "approved_by",
              "executed_at",
              "receipt"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "priority_view",
        "calendar_actions",
        "inbox_queue",
        "briefings",
        "delegated_and_waiting",
        "external_actions"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "evidence_id": {
            "type": "string",
            "description": "Stable evidence identifier.",
            "minLength": 1
          },
          "source_type": {
            "type": "string",
            "enum": [
              "file",
              "line_range",
              "command_output",
              "document",
              "dataset",
              "interview",
              "observation",
              "external_source",
              "other"
            ],
            "minLength": 1
          },
          "source": {
            "type": "string",
            "description": "Path, URL, record identifier, or source name.",
            "minLength": 1
          },
          "location": {
            "type": "string",
            "description": "Line range, section, timestamp, query, or other locator.",
            "minLength": 1
          },
          "supports": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "notes": {
            "type": "string",
            "description": "Limitations or context.",
            "minLength": 1
          }
        },
        "required": [
          "evidence_id",
          "source_type",
          "source",
          "location",
          "supports",
          "confidence",
          "notes"
        ],
        "additionalProperties": false
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "action_id": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "due_or_trigger": {
            "type": "string",
            "minLength": 1
          },
          "priority": {
            "type": "string",
            "enum": [
              "critical",
              "high",
              "medium",
              "low",
              "backlog"
            ],
            "minLength": 1
          },
          "validation": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "proposed",
              "approved",
              "in_progress",
              "blocked",
              "complete",
              "rejected"
            ],
            "minLength": 1
          }
        },
        "required": [
          "action_id",
          "action",
          "owner",
          "due_or_trigger",
          "priority",
          "validation",
          "status"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "prompt_id",
    "run_id",
    "generated_at",
    "epistemic_status",
    "summary",
    "result",
    "evidence",
    "assumptions",
    "unknowns",
    "actions"
  ],
  "additionalProperties": false
}
