{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://generic-prompts.invalid/v3.1/CP-113.schema.json",
  "title": "Paid media brief result",
  "description": "Strict machine-readable result for the prompt. It constrains the work product; it is not a certification of professional correctness.",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "3.1.0",
      "minLength": 1
    },
    "prompt_id": {
      "type": "string",
      "const": "CP-113",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "minLength": 1
    },
    "epistemic_status": {
      "type": "string",
      "enum": [
        "FACT",
        "SUPPORTED_INFERENCE",
        "ASSUMPTION",
        "RECOMMENDATION",
        "MIXED",
        "UNKNOWN"
      ],
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 10
    },
    "result": {
      "type": "object",
      "properties": {
        "paid_media_brief": {
          "type": "object",
          "properties": {
            "overview": {
              "type": "string",
              "minLength": 1
            },
            "key_points": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            },
            "decisions": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "limitations": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "evidence_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "overview",
            "key_points",
            "decisions",
            "limitations",
            "evidence_ids"
          ],
          "additionalProperties": false
        },
        "audience_offer_creative_requirements": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "requirement_id": {
                "type": "string",
                "minLength": 1
              },
              "requirement": {
                "type": "string",
                "minLength": 1
              },
              "source_or_rationale": {
                "type": "string",
                "minLength": 1
              },
              "priority": {
                "type": "string",
                "enum": [
                  "mandatory",
                  "high",
                  "medium",
                  "low",
                  "optional"
                ],
                "minLength": 1
              },
              "status": {
                "type": "string",
                "enum": [
                  "met",
                  "partial",
                  "not_met",
                  "not_tested",
                  "not_applicable"
                ],
                "minLength": 1
              },
              "evidence_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "owner": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "requirement_id",
              "requirement",
              "source_or_rationale",
              "priority",
              "status",
              "evidence_ids",
              "owner"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "budget_pacing_plan": {
          "type": "object",
          "properties": {
            "overview": {
              "type": "string",
              "minLength": 1
            },
            "key_points": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            },
            "decisions": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "limitations": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "evidence_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "overview",
            "key_points",
            "decisions",
            "limitations",
            "evidence_ids"
          ],
          "additionalProperties": false
        },
        "measurement_optimization_rules": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "metric": {
                "type": "string",
                "minLength": 1
              },
              "definition": {
                "type": "string",
                "minLength": 1
              },
              "unit_or_denominator": {
                "type": "string",
                "minLength": 1
              },
              "source": {
                "type": "string",
                "minLength": 1
              },
              "target_or_threshold": {
                "type": "string",
                "minLength": 1
              },
              "owner": {
                "type": "string",
                "minLength": 1
              },
              "decision_use": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "metric",
              "definition",
              "unit_or_denominator",
              "source",
              "target_or_threshold",
              "owner",
              "decision_use"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        }
      },
      "required": [
        "paid_media_brief",
        "audience_offer_creative_requirements",
        "budget_pacing_plan",
        "measurement_optimization_rules"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "evidence_id": {
            "type": "string",
            "description": "Stable evidence identifier.",
            "minLength": 1
          },
          "source_type": {
            "type": "string",
            "enum": [
              "file",
              "line_range",
              "command_output",
              "document",
              "dataset",
              "interview",
              "observation",
              "external_source",
              "other"
            ],
            "minLength": 1
          },
          "source": {
            "type": "string",
            "description": "Path, URL, record identifier, or source name.",
            "minLength": 1
          },
          "location": {
            "type": "string",
            "description": "Line range, section, timestamp, query, or other locator.",
            "minLength": 1
          },
          "supports": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "notes": {
            "type": "string",
            "description": "Limitations or context.",
            "minLength": 1
          }
        },
        "required": [
          "evidence_id",
          "source_type",
          "source",
          "location",
          "supports",
          "confidence",
          "notes"
        ],
        "additionalProperties": false
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "action_id": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "due_or_trigger": {
            "type": "string",
            "minLength": 1
          },
          "priority": {
            "type": "string",
            "enum": [
              "critical",
              "high",
              "medium",
              "low",
              "backlog"
            ],
            "minLength": 1
          },
          "validation": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "proposed",
              "approved",
              "in_progress",
              "blocked",
              "complete",
              "rejected"
            ],
            "minLength": 1
          }
        },
        "required": [
          "action_id",
          "action",
          "owner",
          "due_or_trigger",
          "priority",
          "validation",
          "status"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "prompt_id",
    "run_id",
    "generated_at",
    "epistemic_status",
    "summary",
    "result",
    "evidence",
    "assumptions",
    "unknowns",
    "actions"
  ],
  "additionalProperties": false
}
