{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://generic-prompts.invalid/v3.1/CP-077.schema.json",
  "title": "Hiring scorecard builder result",
  "description": "Strict machine-readable result for the prompt. It constrains the work product; it is not a certification of professional correctness.",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "3.1.0",
      "minLength": 1
    },
    "prompt_id": {
      "type": "string",
      "const": "CP-077",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "minLength": 1
    },
    "epistemic_status": {
      "type": "string",
      "enum": [
        "FACT",
        "SUPPORTED_INFERENCE",
        "ASSUMPTION",
        "RECOMMENDATION",
        "MIXED",
        "UNKNOWN"
      ],
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 10
    },
    "result": {
      "type": "object",
      "properties": {
        "role_mission": {
          "type": "string",
          "minLength": 1
        },
        "outcomes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "outcome_id": {
                "type": "string",
                "minLength": 1
              },
              "horizon_days": {
                "type": "integer",
                "minimum": 1
              },
              "outcome": {
                "type": "string",
                "minLength": 1
              },
              "success_evidence": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "outcome_id",
              "horizon_days",
              "outcome",
              "success_evidence"
            ],
            "additionalProperties": false
          },
          "minItems": 3
        },
        "competencies": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "competency_id": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "linked_outcomes": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              },
              "entry_requirement": {
                "type": "string",
                "enum": [
                  "must_have",
                  "learnable",
                  "optional"
                ],
                "minLength": 1
              },
              "rating_anchors": {
                "type": "object",
                "properties": {
                  "one": {
                    "type": "string",
                    "minLength": 1
                  },
                  "two": {
                    "type": "string",
                    "minLength": 1
                  },
                  "three": {
                    "type": "string",
                    "minLength": 1
                  },
                  "four": {
                    "type": "string",
                    "minLength": 1
                  },
                  "five": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "one",
                  "two",
                  "three",
                  "four",
                  "five"
                ],
                "additionalProperties": false
              },
              "red_flags": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "competency_id",
              "name",
              "linked_outcomes",
              "entry_requirement",
              "rating_anchors",
              "red_flags"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "interview_stages": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "stage": {
                "type": "string",
                "minLength": 1
              },
              "owner": {
                "type": "string",
                "minLength": 1
              },
              "competencies": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              },
              "method": {
                "type": "string",
                "minLength": 1
              },
              "questions_or_work_sample": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              },
              "evidence_capture": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "stage",
              "owner",
              "competencies",
              "method",
              "questions_or_work_sample",
              "evidence_capture"
            ],
            "additionalProperties": false
          }
        },
        "debrief_rules": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      },
      "required": [
        "role_mission",
        "outcomes",
        "competencies",
        "interview_stages",
        "debrief_rules"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "evidence_id": {
            "type": "string",
            "description": "Stable evidence identifier.",
            "minLength": 1
          },
          "source_type": {
            "type": "string",
            "enum": [
              "file",
              "line_range",
              "command_output",
              "document",
              "dataset",
              "interview",
              "observation",
              "external_source",
              "other"
            ],
            "minLength": 1
          },
          "source": {
            "type": "string",
            "description": "Path, URL, record identifier, or source name.",
            "minLength": 1
          },
          "location": {
            "type": "string",
            "description": "Line range, section, timestamp, query, or other locator.",
            "minLength": 1
          },
          "supports": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "notes": {
            "type": "string",
            "description": "Limitations or context.",
            "minLength": 1
          }
        },
        "required": [
          "evidence_id",
          "source_type",
          "source",
          "location",
          "supports",
          "confidence",
          "notes"
        ],
        "additionalProperties": false
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "action_id": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "due_or_trigger": {
            "type": "string",
            "minLength": 1
          },
          "priority": {
            "type": "string",
            "enum": [
              "critical",
              "high",
              "medium",
              "low",
              "backlog"
            ],
            "minLength": 1
          },
          "validation": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "proposed",
              "approved",
              "in_progress",
              "blocked",
              "complete",
              "rejected"
            ],
            "minLength": 1
          }
        },
        "required": [
          "action_id",
          "action",
          "owner",
          "due_or_trigger",
          "priority",
          "validation",
          "status"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "prompt_id",
    "run_id",
    "generated_at",
    "epistemic_status",
    "summary",
    "result",
    "evidence",
    "assumptions",
    "unknowns",
    "actions"
  ],
  "additionalProperties": false
}
