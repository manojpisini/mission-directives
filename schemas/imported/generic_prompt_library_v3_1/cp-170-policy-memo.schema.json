{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://generic-prompts.invalid/v3.1/CP-170.schema.json",
  "title": "Policy memo result",
  "description": "Strict machine-readable result for the prompt. It constrains the work product; it is not a certification of professional correctness.",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "3.1.0",
      "minLength": 1
    },
    "prompt_id": {
      "type": "string",
      "const": "CP-170",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "minLength": 1
    },
    "epistemic_status": {
      "type": "string",
      "enum": [
        "FACT",
        "SUPPORTED_INFERENCE",
        "ASSUMPTION",
        "RECOMMENDATION",
        "MIXED",
        "UNKNOWN"
      ],
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 10
    },
    "result": {
      "type": "object",
      "properties": {
        "decision": {
          "type": "object",
          "properties": {
            "question": {
              "type": "string",
              "minLength": 1
            },
            "owner": {
              "type": "string",
              "minLength": 1
            },
            "deadline": {
              "type": "string",
              "minLength": 1
            },
            "affected_populations": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "baseline_problem": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "question",
            "owner",
            "deadline",
            "affected_populations",
            "baseline_problem"
          ],
          "additionalProperties": false
        },
        "evidence_context": {
          "type": "object",
          "properties": {
            "evidence_summary": {
              "type": "string",
              "minLength": 1
            },
            "quality_limitations": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "legal_institutional_context": {
              "type": "string",
              "minLength": 1
            },
            "stakeholders": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "evidence_summary",
            "quality_limitations",
            "legal_institutional_context",
            "stakeholders"
          ],
          "additionalProperties": false
        },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "option_id": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "mechanism": {
                "type": "string",
                "minLength": 1
              },
              "effectiveness": {
                "type": "string",
                "minLength": 1
              },
              "cost": {
                "type": "string",
                "minLength": 1
              },
              "feasibility": {
                "type": "string",
                "minLength": 1
              },
              "equity_distribution": {
                "type": "string",
                "minLength": 1
              },
              "rights_privacy": {
                "type": "string",
                "minLength": 1
              },
              "risks_unintended_effects": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "evidence_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "option_id",
              "name",
              "mechanism",
              "effectiveness",
              "cost",
              "feasibility",
              "equity_distribution",
              "rights_privacy",
              "risks_unintended_effects",
              "evidence_ids"
            ],
            "additionalProperties": false
          },
          "minItems": 2
        },
        "recommendation": {
          "type": "object",
          "properties": {
            "decision": {
              "type": "string",
              "minLength": 1
            },
            "status": {
              "type": "string",
              "enum": [
                "approve",
                "approve_with_conditions",
                "hold",
                "reject",
                "defer",
                "investigate",
                "not_applicable"
              ],
              "minLength": 1
            },
            "rationale": {
              "type": "string",
              "minLength": 1
            },
            "conditions": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "owner": {
              "type": "string",
              "minLength": 1
            },
            "revisit_trigger": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "decision",
            "status",
            "rationale",
            "conditions",
            "owner",
            "revisit_trigger"
          ],
          "additionalProperties": false
        },
        "implementation": {
          "type": "object",
          "properties": {
            "phases": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "item_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "owner": {
                    "type": "string",
                    "minLength": 1
                  },
                  "start_or_trigger": {
                    "type": "string",
                    "minLength": 1
                  },
                  "due_or_end": {
                    "type": "string",
                    "minLength": 1
                  },
                  "dependencies": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "entry_criteria": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "exit_criteria": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "minItems": 1
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "not_started",
                      "ready",
                      "in_progress",
                      "blocked",
                      "complete",
                      "cancelled"
                    ],
                    "minLength": 1
                  }
                },
                "required": [
                  "item_id",
                  "name",
                  "owner",
                  "start_or_trigger",
                  "due_or_end",
                  "dependencies",
                  "entry_criteria",
                  "exit_criteria",
                  "status"
                ],
                "additionalProperties": false
              }
            },
            "governance": {
              "type": "string",
              "minLength": 1
            },
            "communications": {
              "type": "string",
              "minLength": 1
            },
            "contingency": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "phases",
            "governance",
            "communications",
            "contingency"
          ],
          "additionalProperties": false
        },
        "evaluation": {
          "type": "object",
          "properties": {
            "indicators": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "data_sources": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "review_date": {
              "type": "string",
              "minLength": 1
            },
            "sunset_or_revisit_trigger": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "indicators",
            "data_sources",
            "review_date",
            "sunset_or_revisit_trigger"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "decision",
        "evidence_context",
        "options",
        "recommendation",
        "implementation",
        "evaluation"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "evidence_id": {
            "type": "string",
            "description": "Stable evidence identifier.",
            "minLength": 1
          },
          "source_type": {
            "type": "string",
            "enum": [
              "file",
              "line_range",
              "command_output",
              "document",
              "dataset",
              "interview",
              "observation",
              "external_source",
              "other"
            ],
            "minLength": 1
          },
          "source": {
            "type": "string",
            "description": "Path, URL, record identifier, or source name.",
            "minLength": 1
          },
          "location": {
            "type": "string",
            "description": "Line range, section, timestamp, query, or other locator.",
            "minLength": 1
          },
          "supports": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "notes": {
            "type": "string",
            "description": "Limitations or context.",
            "minLength": 1
          }
        },
        "required": [
          "evidence_id",
          "source_type",
          "source",
          "location",
          "supports",
          "confidence",
          "notes"
        ],
        "additionalProperties": false
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "action_id": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "due_or_trigger": {
            "type": "string",
            "minLength": 1
          },
          "priority": {
            "type": "string",
            "enum": [
              "critical",
              "high",
              "medium",
              "low",
              "backlog"
            ],
            "minLength": 1
          },
          "validation": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "proposed",
              "approved",
              "in_progress",
              "blocked",
              "complete",
              "rejected"
            ],
            "minLength": 1
          }
        },
        "required": [
          "action_id",
          "action",
          "owner",
          "due_or_trigger",
          "priority",
          "validation",
          "status"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "prompt_id",
    "run_id",
    "generated_at",
    "epistemic_status",
    "summary",
    "result",
    "evidence",
    "assumptions",
    "unknowns",
    "actions"
  ],
  "additionalProperties": false
}
