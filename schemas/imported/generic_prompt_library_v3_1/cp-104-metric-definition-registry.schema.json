{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://generic-prompts.invalid/v3.1/CP-104.schema.json",
  "title": "Metric definition registry result",
  "description": "Strict machine-readable result for the prompt. It constrains the work product; it is not a certification of professional correctness.",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "3.1.0",
      "minLength": 1
    },
    "prompt_id": {
      "type": "string",
      "const": "CP-104",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "minLength": 1
    },
    "epistemic_status": {
      "type": "string",
      "enum": [
        "FACT",
        "SUPPORTED_INFERENCE",
        "ASSUMPTION",
        "RECOMMENDATION",
        "MIXED",
        "UNKNOWN"
      ],
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 10
    },
    "result": {
      "type": "object",
      "properties": {
        "metrics": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "metric_id": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "business_definition": {
                "type": "string",
                "minLength": 1
              },
              "decision_use": {
                "type": "string",
                "minLength": 1
              },
              "owner": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "type": "string",
                "enum": [
                  "draft",
                  "approved",
                  "deprecated"
                ],
                "minLength": 1
              },
              "formula": {
                "type": "string",
                "minLength": 1
              },
              "numerator": {
                "type": "string",
                "minLength": 1
              },
              "denominator": {
                "type": "string",
                "minLength": 1
              },
              "grain": {
                "type": "string",
                "minLength": 1
              },
              "filters": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "exclusions": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "time_window": {
                "type": "string",
                "minLength": 1
              },
              "timezone": {
                "type": "string",
                "minLength": 1
              },
              "source_lineage": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              },
              "freshness_sla": {
                "type": "string",
                "minLength": 1
              },
              "quality_checks": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "caveats": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "reference_query": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "metric_id",
              "name",
              "business_definition",
              "decision_use",
              "owner",
              "status",
              "formula",
              "numerator",
              "denominator",
              "grain",
              "filters",
              "exclusions",
              "time_window",
              "timezone",
              "source_lineage",
              "freshness_sla",
              "quality_checks",
              "caveats",
              "reference_query",
              "version"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "definition_conflicts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "concept": {
                "type": "string",
                "minLength": 1
              },
              "versions": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 2
              },
              "resolution": {
                "type": "string",
                "minLength": 1
              },
              "owner": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "concept",
              "versions",
              "resolution",
              "owner"
            ],
            "additionalProperties": false
          }
        },
        "change_policy": {
          "type": "object",
          "properties": {
            "approval": {
              "type": "string",
              "minLength": 1
            },
            "versioning": {
              "type": "string",
              "minLength": 1
            },
            "deprecation": {
              "type": "string",
              "minLength": 1
            },
            "communication": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "approval",
            "versioning",
            "deprecation",
            "communication"
          ],
          "additionalProperties": false
        },
        "usage_examples": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "metric_id": {
                "type": "string",
                "minLength": 1
              },
              "valid_use": {
                "type": "string",
                "minLength": 1
              },
              "invalid_use": {
                "type": "string",
                "minLength": 1
              },
              "example_query_or_reference": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "metric_id",
              "valid_use",
              "invalid_use",
              "example_query_or_reference"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        }
      },
      "required": [
        "metrics",
        "definition_conflicts",
        "change_policy",
        "usage_examples"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "evidence_id": {
            "type": "string",
            "description": "Stable evidence identifier.",
            "minLength": 1
          },
          "source_type": {
            "type": "string",
            "enum": [
              "file",
              "line_range",
              "command_output",
              "document",
              "dataset",
              "interview",
              "observation",
              "external_source",
              "other"
            ],
            "minLength": 1
          },
          "source": {
            "type": "string",
            "description": "Path, URL, record identifier, or source name.",
            "minLength": 1
          },
          "location": {
            "type": "string",
            "description": "Line range, section, timestamp, query, or other locator.",
            "minLength": 1
          },
          "supports": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "notes": {
            "type": "string",
            "description": "Limitations or context.",
            "minLength": 1
          }
        },
        "required": [
          "evidence_id",
          "source_type",
          "source",
          "location",
          "supports",
          "confidence",
          "notes"
        ],
        "additionalProperties": false
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "action_id": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "due_or_trigger": {
            "type": "string",
            "minLength": 1
          },
          "priority": {
            "type": "string",
            "enum": [
              "critical",
              "high",
              "medium",
              "low",
              "backlog"
            ],
            "minLength": 1
          },
          "validation": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "proposed",
              "approved",
              "in_progress",
              "blocked",
              "complete",
              "rejected"
            ],
            "minLength": 1
          }
        },
        "required": [
          "action_id",
          "action",
          "owner",
          "due_or_trigger",
          "priority",
          "validation",
          "status"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "prompt_id",
    "run_id",
    "generated_at",
    "epistemic_status",
    "summary",
    "result",
    "evidence",
    "assumptions",
    "unknowns",
    "actions"
  ],
  "additionalProperties": false
}
