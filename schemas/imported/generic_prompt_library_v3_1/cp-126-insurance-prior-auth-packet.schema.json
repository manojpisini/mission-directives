{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://generic-prompts.invalid/v3.1/CP-126.schema.json",
  "title": "Insurance prior-auth packet result",
  "description": "Strict machine-readable result for the prompt. It constrains the work product; it is not a certification of professional correctness.",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "3.1.0",
      "minLength": 1
    },
    "prompt_id": {
      "type": "string",
      "const": "CP-126",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "minLength": 1
    },
    "epistemic_status": {
      "type": "string",
      "enum": [
        "FACT",
        "SUPPORTED_INFERENCE",
        "ASSUMPTION",
        "RECOMMENDATION",
        "MIXED",
        "UNKNOWN"
      ],
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 10
    },
    "result": {
      "type": "object",
      "properties": {
        "request": {
          "type": "object",
          "properties": {
            "member_reference": {
              "type": "string",
              "minLength": 1
            },
            "payer_plan": {
              "type": "string",
              "minLength": 1
            },
            "provider": {
              "type": "string",
              "minLength": 1
            },
            "service_or_drug": {
              "type": "string",
              "minLength": 1
            },
            "code_or_identifier": {
              "type": "string",
              "minLength": 1
            },
            "urgency": {
              "type": "string",
              "minLength": 1
            },
            "submission_deadline": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "member_reference",
            "payer_plan",
            "provider",
            "service_or_drug",
            "code_or_identifier",
            "urgency",
            "submission_deadline"
          ],
          "additionalProperties": false
        },
        "criteria": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "criterion_id": {
                "type": "string",
                "minLength": 1
              },
              "criterion": {
                "type": "string",
                "minLength": 1
              },
              "source": {
                "type": "string",
                "minLength": 1
              },
              "evidence_reference": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "type": "string",
                "enum": [
                  "met",
                  "not_met",
                  "missing",
                  "unclear",
                  "not_applicable"
                ],
                "minLength": 1
              },
              "clinician_query": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "criterion_id",
              "criterion",
              "source",
              "evidence_reference",
              "status",
              "clinician_query"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "attachments": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "document": {
                "type": "string",
                "minLength": 1
              },
              "date": {
                "type": "string",
                "minLength": 1
              },
              "author": {
                "type": "string",
                "minLength": 1
              },
              "contains_minimum_necessary": {
                "type": "boolean"
              },
              "status": {
                "type": "string",
                "enum": [
                  "ready",
                  "missing",
                  "needs_correction",
                  "not_required"
                ],
                "minLength": 1
              }
            },
            "required": [
              "document",
              "date",
              "author",
              "contains_minimum_necessary",
              "status"
            ],
            "additionalProperties": false
          }
        },
        "submission": {
          "type": "object",
          "properties": {
            "authorized": {
              "type": "boolean"
            },
            "channel": {
              "type": "string",
              "minLength": 1
            },
            "reference_or_receipt": {
              "type": "string",
              "minLength": 1
            },
            "submitted_at": {
              "type": "string",
              "minLength": 1
            },
            "sla": {
              "type": "string",
              "minLength": 1
            },
            "status": {
              "type": "string",
              "enum": [
                "not_submitted",
                "submitted",
                "pending",
                "approved",
                "denied",
                "withdrawn"
              ],
              "minLength": 1
            }
          },
          "required": [
            "authorized",
            "channel",
            "reference_or_receipt",
            "submitted_at",
            "sla",
            "status"
          ],
          "additionalProperties": false
        },
        "follow_up": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "action_id": {
                "type": "string",
                "minLength": 1
              },
              "action": {
                "type": "string",
                "minLength": 1
              },
              "owner": {
                "type": "string",
                "minLength": 1
              },
              "due_or_trigger": {
                "type": "string",
                "minLength": 1
              },
              "priority": {
                "type": "string",
                "enum": [
                  "critical",
                  "high",
                  "medium",
                  "low",
                  "backlog"
                ],
                "minLength": 1
              },
              "validation": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "type": "string",
                "enum": [
                  "proposed",
                  "approved",
                  "in_progress",
                  "blocked",
                  "complete",
                  "rejected"
                ],
                "minLength": 1
              }
            },
            "required": [
              "action_id",
              "action",
              "owner",
              "due_or_trigger",
              "priority",
              "validation",
              "status"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "request",
        "criteria",
        "attachments",
        "submission",
        "follow_up"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "evidence_id": {
            "type": "string",
            "description": "Stable evidence identifier.",
            "minLength": 1
          },
          "source_type": {
            "type": "string",
            "enum": [
              "file",
              "line_range",
              "command_output",
              "document",
              "dataset",
              "interview",
              "observation",
              "external_source",
              "other"
            ],
            "minLength": 1
          },
          "source": {
            "type": "string",
            "description": "Path, URL, record identifier, or source name.",
            "minLength": 1
          },
          "location": {
            "type": "string",
            "description": "Line range, section, timestamp, query, or other locator.",
            "minLength": 1
          },
          "supports": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "notes": {
            "type": "string",
            "description": "Limitations or context.",
            "minLength": 1
          }
        },
        "required": [
          "evidence_id",
          "source_type",
          "source",
          "location",
          "supports",
          "confidence",
          "notes"
        ],
        "additionalProperties": false
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "action_id": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "due_or_trigger": {
            "type": "string",
            "minLength": 1
          },
          "priority": {
            "type": "string",
            "enum": [
              "critical",
              "high",
              "medium",
              "low",
              "backlog"
            ],
            "minLength": 1
          },
          "validation": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "proposed",
              "approved",
              "in_progress",
              "blocked",
              "complete",
              "rejected"
            ],
            "minLength": 1
          }
        },
        "required": [
          "action_id",
          "action",
          "owner",
          "due_or_trigger",
          "priority",
          "validation",
          "status"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "prompt_id",
    "run_id",
    "generated_at",
    "epistemic_status",
    "summary",
    "result",
    "evidence",
    "assumptions",
    "unknowns",
    "actions"
  ],
  "additionalProperties": false
}
